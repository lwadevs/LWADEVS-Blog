---
/**
 * index.astro - Clean workspace landing page for Lawrence Wayne Austin (lwa {dev})
 * Replaces heavy WordPress templates with a bright, minimalist, bespoke static frontend.
 */
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";

const recentPosts = getSortedPosts(await getCollection("posts")).slice(0, 4);
---

<Layout
  title="Lawrence Wayne Austin | lwa {dev}"
  description="Personal developer brand website for Lawrence Wayne Austin (lwa {dev}) - Create, Configure, Develop, Design."
>
  <!-- Hero & Centered Workspace Illustration Section -->
  <section class="flex flex-col items-center text-center pt-2 pb-16 md:pb-24">
    <!-- Prominent Centered Illustration Asset Slot -->
    <div class="w-full max-w-2xl mx-auto mb-10 transition-transform duration-500 hover:scale-[1.01]">
      <div class="relative w-full aspect-[16/10] bg-slate-50 border border-slate-100 rounded-2xl p-6 sm:p-10 flex items-center justify-center overflow-hidden shadow-sm group">
        <!-- Background subtle blueprint grid pattern -->
        <div
          class="absolute inset-0 opacity-[0.03] pointer-events-none"
          style="background-image: radial-gradient(#0f172a 1px, transparent 1px); background-size: 24px 24px;"
        ></div>

        <!-- Semantic Developer Workspace Vector Illustration -->
        <svg
          class="w-full h-full max-h-72 object-contain select-none"
          viewBox="0 0 680 400"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-label="Lawrence Wayne Austin developer workspace with laptop, code display, coffee mug, and desk plants"
          role="img"
        >
          <!-- Desk Platform Surface -->
          <ellipse cx="340" cy="365" rx="310" ry="24" fill="#F1F5F9" />
          <path d="M 60 340 L 620 340 L 590 358 L 90 358 Z" fill="#E2E8F0" />
          <rect x="75" y="340" width="530" height="6" rx="3" fill="#CBD5E1" />

          <!-- Modern Studio Display (Center Right) -->
          <g id="main-monitor" class="transition-transform duration-300 group-hover:-translate-y-1">
            <!-- Stand & Base -->
            <path d="M 330 295 L 350 295 L 345 340 L 335 340 Z" fill="#94A3B8" />
            <ellipse cx="340" cy="340" rx="42" ry="7" fill="#64748B" />
            <!-- Display Body -->
            <rect x="180" y="70" width="320" height="225" rx="14" fill="#0F172A" stroke="#1E293B" stroke-width="4" />
            <!-- Display Inner Screen -->
            <rect x="190" y="80" width="300" height="205" rx="8" fill="#020617" />
            <!-- Code Editor Window Header -->
            <rect x="190" y="80" width="300" height="22" rx="8" fill="#0F172A" />
            <circle cx="204" cy="91" r="3.5" fill="#EF4444" />
            <circle cx="216" cy="91" r="3.5" fill="#F59E0B" />
            <circle cx="228" cy="91" r="3.5" fill="#10B981" />
            <text x="250" y="94" font-family="monospace" font-size="9" fill="#64748B">Workspace.astro — lwa&#123;dev&#125;</text>

            <!-- Code Lines Representation -->
            <g opacity="0.9">
              <text x="206" y="122" font-family="monospace" font-size="11" fill="#38BDF8">const</text>
              <text x="246" y="122" font-family="monospace" font-size="11" fill="#F8FAFC">developer</text>
              <text x="312" y="122" font-family="monospace" font-size="11" fill="#94A3B8">=</text>
              <text x="326" y="122" font-family="monospace" font-size="11" fill="#FBBF24">&#123;</text>

              <text x="220" y="142" font-family="monospace" font-size="10" fill="#94A3B8">name:</text>
              <text x="260" y="142" font-family="monospace" font-size="10" fill="#34D399">'Lawrence Wayne Austin'</text>
              <text x="424" y="142" font-family="monospace" font-size="10" fill="#94A3B8">,</text>

              <text x="220" y="160" font-family="monospace" font-size="10" fill="#94A3B8">brand:</text>
              <text x="265" y="160" font-family="monospace" font-size="10" fill="#60A5FA">'lwa &#123;dev&#125;'</text>
              <text x="330" y="160" font-family="monospace" font-size="10" fill="#94A3B8">,</text>

              <text x="220" y="178" font-family="monospace" font-size="10" fill="#94A3B8">craft:</text>
              <text x="262" y="178" font-family="monospace" font-size="10" fill="#F472B6">['Create', 'Configure', 'Develop', 'Design']</text>
              <text x="475" y="178" font-family="monospace" font-size="10" fill="#94A3B8">,</text>

              <text x="220" y="196" font-family="monospace" font-size="10" fill="#94A3B8">stack:</text>
              <text x="264" y="196" font-family="monospace" font-size="10" fill="#FDE047">'Astro · Tailwind · TypeScript'</text>

              <text x="206" y="216" font-family="monospace" font-size="11" fill="#FBBF24">&#125;;</text>

              <text x="206" y="240" font-family="monospace" font-size="10" fill="#38BDF8">export</text>
              <text x="250" y="240" font-family="monospace" font-size="10" fill="#38BDF8">default</text>
              <text x="296" y="240" font-family="monospace" font-size="10" fill="#F8FAFC">developer.build();</text>
            </g>

            <!-- Screen Gloss/Reflect Line -->
            <path d="M 480 80 L 440 80 L 400 280 L 440 280 Z" fill="#FFFFFF" opacity="0.03" />
          </g>

          <!-- Desk Accessory: Small Ceramic Coffee Mug (Right) -->
          <g id="coffee-mug" class="transition-transform duration-300 group-hover:rotate-1">
            <rect x="525" y="305" width="28" height="35" rx="5" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="2" />
            <path d="M 553 313 C 564 313 564 330 553 330" fill="none" stroke="#CBD5E1" stroke-width="2.5" />
            <ellipse cx="539" cy="309" rx="10" ry="3" fill="#78350F" />
            <path d="M 536 298 Q 533 291 537 284" stroke="#CBD5E1" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.7" />
            <path d="M 542 296 Q 546 290 541 282" stroke="#CBD5E1" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.7" />
          </g>

          <!-- Desk Accessory: Minimal Potted Plant (Left) -->
          <g id="desk-plant">
            <path d="M 112 320 L 138 320 L 133 340 L 117 340 Z" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2" />
            <path d="M 125 320 Q 120 290 108 275" stroke="#059669" stroke-width="3" stroke-linecap="round" fill="none" />
            <path d="M 125 320 Q 130 285 142 270" stroke="#10B981" stroke-width="3" stroke-linecap="round" fill="none" />
            <path d="M 125 320 Q 125 280 126 265" stroke="#34D399" stroke-width="2.5" stroke-linecap="round" fill="none" />
            <ellipse cx="106" cy="273" rx="12" ry="7" transform="rotate(-30 106 273)" fill="#10B981" opacity="0.9" />
            <ellipse cx="144" cy="268" rx="12" ry="7" transform="rotate(30 144 268)" fill="#059669" opacity="0.9" />
            <ellipse cx="126" cy="262" rx="9" ry="14" fill="#34D399" opacity="0.9" />
          </g>

          <!-- Desk Accessory: Minimal Mechanical Keyboard & Notebook -->
          <g id="peripherals">
            <rect x="250" y="325" width="180" height="15" rx="3" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.5" />
            <rect x="445" y="328" width="16" height="12" rx="6" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.5" />
          </g>
        </svg>
      </div>
    </div>

    <!-- Subheaders Under Image -->
    <div class="space-y-3">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900 font-mono">
        lwa <span class="text-slate-400 font-normal">{`{dev}`}</span>
      </h1>
      <p class="text-sm sm:text-base font-mono tracking-wide text-slate-500 uppercase">
        <span class="text-slate-400">&#123;</span>
        <span class="text-slate-700 font-medium">Create</span>
        <span class="text-slate-300 mx-1">:</span>
        <span class="text-slate-700 font-medium">Configure</span>
        <span class="text-slate-300 mx-1">:</span>
        <span class="text-slate-700 font-medium">Develop</span>
        <span class="text-slate-300 mx-1">:</span>
        <span class="text-slate-700 font-medium">Design</span>
        <span class="text-slate-400">&#125;</span>
      </p>
    </div>

    <!-- Welcoming Introduction Paragraph Block -->
    <div id="about" class="mt-8 max-w-2xl mx-auto">
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        Welcome to my digital workshop. I'm <strong class="font-semibold text-slate-900">Lawrence Wayne Austin</strong>,
        a frontend software engineer and systems architect crafting fast, resilient web applications.
        I transitioned this space from bloated WordPress templates to a razor-clean static architecture,
        celebrating deliberate typography, intentional whitespace, and modular engineering.
      </p>
    </div>
  </section>

  <!-- Large 'CREATIVE DESIGN' Outlined Text & Branding Elements Section -->
  <section id="creative-design" class="py-16 md:py-24 border-t border-slate-100">
    <div class="text-center space-y-4 mb-14">
      <!-- Animated Developer Graphic Asset -->
      <div class="flex justify-center mb-6">
        <img
          src="/lwa.dev-animated-gif_projects_dev.webp"
          alt="Animated illustration of Lawrence Wayne Austin developing at a laptop"
          class="w-48 sm:w-56 md:w-64 h-auto object-contain mx-auto transition-transform duration-300 hover:scale-[1.02]"
          loading="lazy"
        />
      </div>

      <span class="text-xs font-mono uppercase tracking-widest text-slate-400 block">
        Core Philosophy &amp; Discipline
      </span>

      <!-- Prominent Outlined Typography Header -->
      <h2
        class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black uppercase tracking-wider select-none text-transparent transition-all duration-300 cursor-default"
        style="-webkit-text-stroke: 2px #0f172a;"
      >
        Creative Design
      </h2>

      <p class="text-sm sm:text-base text-slate-500 max-w-xl mx-auto leading-relaxed">
        Engineering is incomplete without aesthetic discipline. I construct web systems where visual poise and architectural rigor reinforce one another.
      </p>
    </div>

    <!-- Four Pillars of Craft: Create · Configure · Develop · Design -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="p-6 rounded-xl border border-slate-100 bg-white hover:border-slate-300 transition-all duration-200 group">
        <div class="font-mono text-xs text-slate-400 mb-2">01.</div>
        <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-slate-700 transition-colors">
          Create
        </h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Transforming nascent product ideas and user requirements into clean, scalable interfaces with crisp typographic foundations.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-slate-100 bg-white hover:border-slate-300 transition-all duration-200 group">
        <div class="font-mono text-xs text-slate-400 mb-2">02.</div>
        <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-slate-700 transition-colors">
          Configure
        </h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Architecting reliable CI/CD pipelines, reproducible development environments, and razor-sharp build tooling with zero bloat.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-slate-100 bg-white hover:border-slate-300 transition-all duration-200 group">
        <div class="font-mono text-xs text-slate-400 mb-2">03.</div>
        <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-slate-700 transition-colors">
          Develop
        </h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Writing bulletproof TypeScript, semantic HTML, and performant component architectures that load instantaneously.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-slate-100 bg-white hover:border-slate-300 transition-all duration-200 group">
        <div class="font-mono text-xs text-slate-400 mb-2">04.</div>
        <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-slate-700 transition-colors">
          Design
        </h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Balancing mathematical whitespace, typographic rhythm, and subtle interactive micro-states for an enduring user experience.
        </p>
      </div>
    </div>
  </section>

  <!-- Designated Blog Collections Placeholder Section -->
  <section id="writing" class="py-16 md:py-24 border-t border-slate-100">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-slate-400 block mb-1">
          Astro Content Collections
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900">
          Selected Writing &amp; Notes
        </h2>
      </div>
      <p class="text-xs text-slate-400 font-mono max-w-xs">
        Recent articles from <code class="text-slate-600 bg-slate-50 px-1 py-0.5 rounded">src/content/posts/</code>
      </p>
    </div>

    <!-- Mapped Post Entries -->
    <div class="divide-y divide-slate-100">
      {
        recentPosts.map((post) => (
          <article class="py-8 group transition-colors">
            <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 mb-2">
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-slate-600 transition-colors">
                <a href={getPostUrl(post.id, post.filePath)} class="focus:outline-none">
                  {post.data.title}
                </a>
              </h3>
              <div class="flex items-center gap-2 text-xs text-slate-400 shrink-0 font-mono">
                <span>{post.data.tags[0] ?? "Article"}</span>
                <span aria-hidden="true">&middot;</span>
                <time datetime={post.data.pubDatetime.toISOString()}>
                  {post.data.pubDatetime.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                  })}
                </time>
              </div>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed max-w-2xl">
              {post.data.description}
            </p>
          </article>
        ))
      }
    </div>

    <!-- Link to the full article archive -->
    <a
      href="/posts"
      class="group mt-12 block rounded-xl border border-slate-200 bg-slate-50 p-6 text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-slate-300 hover:bg-white hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2"
    >
      <div class="mb-2 flex items-center gap-2 font-mono text-base font-semibold text-slate-900 sm:text-lg">
        <svg class="h-5 w-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Explore the complete archive</span>
      </div>
      <p class="text-sm leading-relaxed text-slate-600 sm:text-base">
        Browse the full collection of published posts in the <span class="font-semibold text-slate-900 underline decoration-slate-400 underline-offset-4 group-hover:decoration-slate-700">article archive</span>.
      </p>
    </a>
  </section>

  <!-- Minimalist Contact Section -->
  <section id="contact" class="py-16 border-t border-slate-100 text-center">
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3">Let's Build Something Exceptional</h2>
    <p class="text-sm text-slate-500 max-w-md mx-auto mb-6">
      Whether you need frontend architecture, design systems, or systems configuration, feel free to reach out.
    </p>
    <a
      href="mailto:lawrencewayneaustin.dev@outlook.com"
      class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 text-white rounded-lg text-sm font-semibold hover:bg-slate-800 transition-all shadow-sm"
    >
      <span>lawrencewayneaustin.dev@outlook.com</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
    <div class="flex justify-center pt-6">
      <a
        href="mailto:lawrencewayneaustin.dev@outlook.com"
        aria-label="Email Lawrence Wayne Austin"
        class="inline-block"
      >
        <img
          src="/contact_me_mail.gif"
          alt="Animated email illustration"
          class="w-48 sm:w-56 md:w-64 h-auto object-contain mx-auto transition-transform duration-300 hover:scale-[1.02]"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>
</Layout>