---
import Layout from "@/layouts/Layout.astro";

interface GitHubRepo {
  name: string;
  html_url: string;
  description: string | null;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  updated_at: string;
  archived: boolean;
}

function isGitHubRepo(value: unknown): value is GitHubRepo {
  if (typeof value !== "object" || value === null) return false;

  return (
    "name" in value &&
    typeof value.name === "string" &&
    "html_url" in value &&
    typeof value.html_url === "string" &&
    "description" in value &&
    (typeof value.description === "string" || value.description === null) &&
    "language" in value &&
    (typeof value.language === "string" || value.language === null) &&
    "stargazers_count" in value &&
    typeof value.stargazers_count === "number" &&
    "forks_count" in value &&
    typeof value.forks_count === "number" &&
    "updated_at" in value &&
    typeof value.updated_at === "string" &&
    "archived" in value &&
    typeof value.archived === "boolean"
  );
}

const githubUsername = "lwadevs";
const repos: GitHubRepo[] = [];

for (let page = 1; ; page += 1) {
  const response = await fetch(
    `https://api.github.com/users/${githubUsername}/repos?per_page=100&sort=updated&page=${page}`,
    {
      headers: {
        Accept: "application/vnd.github+json",
        "User-Agent": "lwa-dev-portfolio",
      },
    }
  );

  if (!response.ok) {
    throw new Error(
      `Could not load public repositories for GitHub user "${githubUsername}" (${response.status} ${response.statusText}).`
    );
  }

  const pageRepos: unknown = await response.json();
  if (!Array.isArray(pageRepos)) {
    throw new Error(
      `GitHub returned an unexpected repository list for "${githubUsername}".`
    );
  }

  const validRepos = pageRepos.filter(isGitHubRepo);
  if (validRepos.length !== pageRepos.length) {
    throw new Error(
      `GitHub returned repository data in an unexpected format for "${githubUsername}".`
    );
  }

  repos.push(...validRepos);
  if (pageRepos.length < 100) break;
}
---

<Layout
  title="GitHub.{dev} | Lawrence Wayne Austin"
  description="Explore Lawrence Wayne Austin's public GitHub repositories, projects, and development work."
>
  <section class="mb-16 grid items-center gap-8 sm:grid-cols-[1fr_auto] sm:gap-12">
    <div>
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-slate-400">
        // Open-source work
      </p>
      <h1 class="mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        GitHub<span class="font-mono text-slate-400">.&#123;dev&#125;</span>
      </h1>
      <p class="max-w-2xl text-base leading-relaxed text-slate-600">
        A collection of experiments, learning projects, and practical tools
        across web development, Linux, and software.
      </p>
      <a
        href="https://github.com/lwadevs"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2"
      >
        View GitHub profile
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <img
      src="/github/developer-at-work.gif"
      alt="Animated illustration of a developer working at a laptop"
      class="mx-auto w-52 object-contain sm:w-64"
      width="256"
      loading="lazy"
      decoding="async"
    />
  </section>

  <section class="mb-16" aria-labelledby="repositories-heading">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2
          id="repositories-heading"
          class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400"
        >
          // Public repositories
        </h2>
        <p class="mt-2 text-sm text-slate-600">
          Repositories for <span class="font-semibold text-slate-900">@{githubUsername}</span>,
          refreshed each time the site is built.
        </p>
      </div>
      <span
        class="shrink-0 rounded-full border border-slate-200 bg-white px-3 py-1 font-mono text-xs text-slate-600"
      >
        {repos.length} repos
      </span>
    </div>

    {repos.length > 0 ? (
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {repos.map(repo => (
          <a
            href={repo.html_url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-48 flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-slate-300 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2"
          >
            <div>
              <div class="mb-3 flex items-start justify-between gap-3">
                <h3 class="break-words font-mono text-sm font-semibold text-slate-900 group-hover:underline">
                  {repo.name}
                </h3>
                <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-medium text-slate-600">
                  {repo.language ?? "Repository"}
                </span>
              </div>
              <p class="text-sm leading-relaxed text-slate-600">
                {repo.description ?? "No description provided."}
              </p>
            </div>
            <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-slate-500">
              <span>★ {repo.stargazers_count}</span>
              <span>Forks {repo.forks_count}</span>
              {repo.archived && (
                <span class="rounded-full border border-slate-200 px-2 py-0.5">
                  Archived
                </span>
              )}
              <time
                class="ml-auto"
                datetime={repo.updated_at}
                title={`Updated ${new Date(repo.updated_at).toLocaleDateString()}`}
              >
                Updated {new Date(repo.updated_at).toLocaleDateString("en", {
                  month: "short",
                  year: "numeric",
                })}
              </time>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="rounded-xl border border-slate-200 bg-slate-50 p-6 text-sm text-slate-600">
        No public repositories were found for this account.
      </p>
    )}
  </section>

  <section
    class="flex flex-col items-center gap-5 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center sm:flex-row sm:text-left"
  >
    <img
      src="/github/github-octocat.gif"
      alt="Animated GitHub Octocat"
      class="h-24 w-24 object-contain"
      width="96"
      height="96"
      loading="lazy"
      decoding="async"
    />
    <div>
      <h2 class="text-lg font-semibold text-slate-900">
        Follow along on GitHub
      </h2>
      <p class="mt-1 text-sm leading-relaxed text-slate-600">
        Explore the source, browse the latest repositories, and follow future
        projects.
      </p>
    </div>
  </section>
</Layout>
