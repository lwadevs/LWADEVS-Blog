---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Projects.{dev} | Lawrence Wayne Austin"
  description="Selected client work, including the TDRAUTOS LTD website, and development projects by Lawrence Wayne Austin."
>
  <section class="mb-16 grid items-center gap-8 sm:grid-cols-[1fr_auto] sm:gap-12">
    <div>
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-slate-400">
        // Selected work
      </p>
      <h1 class="mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Projects<span class="font-mono text-slate-400">.&#123;dev&#125;</span>
      </h1>
      <p class="max-w-2xl text-base leading-relaxed text-slate-600">
        Form follows function. I bring design and development together to create
        clear, useful digital experiences, guided by the principles of Material
        Design.
      </p>
      <p class="mt-4 font-mono text-sm font-medium text-slate-700">
        Create: Configure: Develop: Design.
      </p>
    </div>
    <img
      src="/projects/tdrautos/lwa-dev-work.gif"
      alt="Animated illustration of Lawrence Wayne Austin at work"
      class="mx-auto w-36 object-contain sm:w-44"
      width="176"
      loading="lazy"
      decoding="async"
    />
  </section>

  <section class="mb-16" aria-labelledby="featured-work-heading">
    <h2
      id="featured-work-heading"
      class="mb-6 font-mono text-xs uppercase tracking-[0.2em] text-slate-400"
    >
      // Featured case studies
    </h2>
    <article
      class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md"
    >
      <a
        href="https://www.tdrautos.co.uk/contact-us/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View the TDRAUTOS LTD website"
        class="block overflow-hidden bg-slate-100"
      >
        <img
          src="/projects/tdrautos/tdrautos-homepage.png"
          alt="TDRAUTOS LTD website homepage, featuring its Bromley garage and motorcycle repair services"
          class="aspect-video w-full object-cover object-center transition-transform duration-300 hover:scale-[1.02]"
          width="1024"
          height="512"
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="p-6 sm:p-8">
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.16em] text-slate-400">
          Client website
        </p>
        <h3 class="text-xl font-semibold tracking-tight text-slate-900">
          TDRAUTOS LTD
        </h3>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600">
          An automotive and motorcycle garage based in Bromley, providing vehicle
          servicing and repairs.
        </p>
        <a
          href="https://www.tdrautos.co.uk/contact-us/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2"
        >
          Visit TDRAUTOS
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 17 17 7M7 7h10v10"
            />
          </svg>
        </a>
      </div>
    </article>
  </section>

  <section
    class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8"
    aria-labelledby="next-steps-heading"
  >
    <h2 id="next-steps-heading" class="mb-3 text-lg font-semibold text-slate-900">
      Building something together?
    </h2>
    <p class="mb-5 max-w-2xl text-sm leading-relaxed text-slate-600">
      Get in touch to discuss a website, design system, or development project.
    </p>
    <a
      href="mailto:lawrencewayneaustin.dev@outlook.com"
      class="inline-flex items-center rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2"
    >
      Contact me
    </a>
  </section>
</Layout>
